---
import type { Collation } from '~/types'

interface Props {
  tags: Collation<'posts'>[]
}

const { tags } = Astro.props
---

<div class="flex flex-wrap gap-x-3 gap-y-1 text-sm">
  {
    tags.map((tag) => (
      <a
        href={tag.url}
        class="bracket-link text-link hover:text-accent no-underline transition-colors"
      >
        {tag.title}
      </a>
    ))
  }
</div>
