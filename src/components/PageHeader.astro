---
import CommandLine from '~/components/CommandLine.astro'

interface Props {
  title?: string
}

const { title } = Astro.props

const splitPath: string[] = Astro.url.pathname.split('/').filter(Boolean) // Remove empty parts
// Pagination pages end in a number ("/posts/2"); the path reads better without it.
const pathParts =
  splitPath.length > 1 && /^\d+$/.test(splitPath[splitPath.length - 1])
    ? splitPath.slice(0, -1)
    : splitPath

const path = `~/${pathParts.map((part) => decodeURIComponent(part)).join('/')}`
const heading = title || decodeURIComponent(pathParts[pathParts.length - 1] || 'home')
---

<div class="mt-6 mb-2 md:mt-8">
  <CommandLine command={`cd ${path}`} class="text-sm" />
  <div class="mt-4 w-fit max-w-full">
    <h1 class="text-heading1 text-3xl leading-tight font-bold tracking-tight">
      {heading}
    </h1>
    <div class="gradient-rule mt-2"></div>
  </div>
</div>
