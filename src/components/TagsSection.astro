---
import type { CollectionEntry } from 'astro:content'
import { TagsGroup } from '~/utils'

interface Props {
  posts: CollectionEntry<'posts'>[]
  limit?: number
}

const { posts, limit = 10 } = Astro.props
const tagsGroup = await TagsGroup.build(posts)
const topTags = tagsGroup.sortCollationsLargest().slice(0, limit)
---

<ul class="collation-grid my-5">
  {
    topTags.map((tag) => (
      <li>
        <a
          href={tag.url}
          class="card-lift collation-card flex items-center justify-between gap-3 px-4 py-3 no-underline"
        >
          <span class="flex min-w-0 flex-col gap-0.5">
            <span class="text-foreground truncate font-semibold">{tag.title}</span>
            <span class="text-(--term-dim) text-sm">
              {tag.entries.length} {tag.entries.length === 1 ? 'post' : 'posts'}
            </span>
          </span>
          <span class="collation-arrow text-(--term-dim) shrink-0" aria-hidden="true">
            →
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .collation-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 0.75rem;
  }

  .collation-arrow {
    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }

  .collation-card:hover .collation-arrow {
    color: var(--theme-accent);
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .collation-arrow {
      transition: none;
    }

    .collation-card:hover .collation-arrow {
      transform: none;
    }
  }
</style>
