---
import siteConfig from '~/site.config'
import SocialLinks from '~/components/SocialLinks.astro'

const currentYear = new Date().getFullYear()
---

<footer
  class="border-(--term-line) mt-auto flex max-w-full grow-0 flex-col items-center justify-between gap-6 border-t pt-8 md:pt-10"
>
  {siteConfig.socialLinks && <SocialLinks socialLinks={siteConfig.socialLinks} />}
  <div class="text-(--term-dim) flex flex-col items-center gap-1 text-sm">
    <p class="command-line max-w-full">
      <span class="prompt" aria-hidden="true">$</span>
      <span class="command truncate">echo "&copy; {currentYear} {siteConfig.author}"</span
      >
    </p>
    <p class="text-center">
      Powered by <a
        class="link-sweep"
        target="_blank"
        rel="noopener noreferrer"
        href="https://astro.build">Astro</a
      >
      &amp; <a
        class="link-sweep"
        target="_blank"
        rel="noopener noreferrer"
        href="https://github.com/stelcodes/multiterm-astro">MultiTerm</a
      >
    </p>
  </div>
</footer>
