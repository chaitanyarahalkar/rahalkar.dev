---
import Layout from '~/layouts/Layout.astro'
import CommandLine from '~/components/CommandLine.astro'
import type { MarkdownLayoutProps } from 'astro'

type Props = MarkdownLayoutProps<{
  // Define frontmatter props here
  title: string
  description?: string
}>

// Now, `frontmatter`, `url`, and other Markdown layout properties
// are accessible with type safety
const { frontmatter } = Astro.props
const path = Astro.url.pathname.replace(/\/$/, '')
---

<Layout title={frontmatter.title} description={frontmatter.description}>
  <div class="max-w-full py-7.5">
    <div class="md:mx-2">
      <CommandLine command={`cat ~${path}.md`} class="text-sm" />
      <h1
        class="text-heading1 mt-4 w-fit text-[1.9rem] leading-tight font-bold tracking-tight"
      >
        {frontmatter.title}
      </h1>
      <div class="gradient-rule mt-3 w-full max-w-40"></div>
    </div>
    <div class="prose mt-6 mb-5">
      <slot />
    </div>
  </div>
</Layout>
